<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows7.0</TargetFramework>
    <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ApplicationBuilderSample.VisualBasic</RootNamespace>
    <StartupObject>ApplicationBuilderSample.VisualBasic.Program</StartupObject>
    <OptionExplicit>On</OptionExplicit>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <ProjectReference Include="..\..\..\..\src\System.Windows.Forms\System.Windows.Forms.csproj" />
  </ItemGroup>

</Project>
